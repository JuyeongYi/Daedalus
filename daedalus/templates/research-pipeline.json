    {
      "kind": "procedural_skill",
      "id": "87477004f4284810b234bec782e86bd9",
      "name": "synthesize-findings",
      "description": "Placeholder: merge the parallel findings into one answer.",
      "when_to_use": "",
      "body": "Merge the findings into one answer.\n\n- Read `ResearchPlan` and `Findings` together. Answer the topic, not the\n  questions one by one — a list of answers is not a synthesis.\n- Where investigators disagree, say so and say which reading the evidence\n  favours. Do not average them into a bland sentence.\n- Carry `Findings.unanswered` into `ResearchReport.open_questions`. Gaps are part\n  of the result.\n- Set `confidence` from the evidence you actually have, not from how much text\n  was produced.",
      "config": {
        "kind": "procedural",
        "model": "inherit",
        "effort": null,
        "hooks": null,
