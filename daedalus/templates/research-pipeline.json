  "skills": [
    {
      "kind": "procedural_skill",
      "id": "607b8321bd0e45b89f6a7fd83a09a1b3",
      "name": "plan-research",
      "description": "Placeholder: split a research topic into independently answerable questions.",
      "when_to_use": "",
      "body": "Split the topic into questions that can be answered *independently* —\nthat is what makes the next step parallel.\n\n1. State the topic in one sentence and write it to `ResearchPlan.topic`.\n2. Break it into questions that do not depend on each other's answers. If two\n   questions must be answered in order, they are one question.\n3. Write `done_when`: the condition under which the research is finished. Without\n   it the loop never closes.\n4. Record the questions in `ResearchPlan.questions`, then hand off.\n\nDo not answer any of the questions here.",
      "config": {
        "kind": "procedural",
        "model": "inherit",
        "effort": null,
        "hooks": null,
        "argument_hint": null,
        "allowed_tools": [],
        "paths": null,
        "disable_model_invocation": false,
        "user_invocable": true,
        "context": "inline",
        "agent": null,
        "shell": "bash"
      },
