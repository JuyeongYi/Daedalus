    {
      "kind": "procedural_skill",
      "id": "927b0fdde76f40ababe45c4287ccdac6",
      "name": "dispatch-investigators",
      "description": "Placeholder: run one investigator subagent per open question, in parallel.",
      "when_to_use": "",
      "body": "Run the investigators.\n\n- Read `ResearchPlan.questions`. Launch **one investigator per question**, in a\n  single batch, so they run in parallel. Launching them one at a time turns a\n  parallel plan back into a serial one.\n- Give each investigator exactly one question. An investigator with three\n  questions returns one shallow answer.\n- Wait for all of them before moving on.",
      "config": {
        "kind": "procedural",
        "model": "inherit",
        "effort": null,
        "hooks": null,
        "argument_hint": null,
        "allowed_tools": [],
        "paths": null,
        "disable_model_invocation": null,
