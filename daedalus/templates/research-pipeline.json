    {
      "kind": "procedural_skill",
      "id": "6faabd1003ae4ce194899bbc837ff8f6",
      "name": "deliver-report",
      "description": "Placeholder: hand the finished report to the user.",
      "when_to_use": "",
      "body": "Hand the report to the user.\n\n- Lead with the answer, then the confidence, then the open questions.\n- Cite the sources recorded in `Findings.sources` for the claims that carry the\n  answer.\n- Keep it to what was asked. The research was broad so the report does not have\n  to be.",
