      "config": {
        "kind": "agent",
        "model": "inherit",
        "effort": null,
        "hooks": null,
        "tools": null,
        "disallowed_tools": null,
        "permission_mode": "default",
        "max_turns": null,
        "skills": [],
        "mcp_servers": null,
        "memory": null,
        "background": false,
        "isolation": "none",
        "color": null
      },
      "execution_policy": {
        "mode": "fixed",
        "count": 1,
        "join": "all",
        "join_count": null
      },
      "body": "You review the change against `TaskSpec` and nothing else.\n\n1. Read `TaskSpec`. The acceptance criteria are the standard; your taste is not.\n2. Inspect the change. Separate what is *wrong* (blocking) from what you would\n   *prefer* (suggestion). Only blocking items may hold up approval.\n3. Write `ReviewFindings`: `verdict`, the blocking items, the suggestions, and\n   the round number (increment it if findings already exist).\n4. Exit through `approved` only when there are no blocking items left.\n\nDo not fix the code yourself. Reviewing and implementing in one pass loses the\nindependent check that this step exists for.",
      "reference_placements": [],
      "graph_layout": {},
      "edge_layout": {},
      "transfer_on": [
        {
          "name": "approved",
          "color": "#44aa66",
          "description": "No blocking findings — the change meets the spec."
        },
        {
          "name": "changes-requested",
          "color": "#dd7744",
          "description": "Blocking findings were recorded; another implementation round is needed."
        }
      ]
    }
  ],
