    {
      "kind": "agent",
      "id": "b29a28b33ffd4809848561832c2e0f66",
      "name": "implementer",
      "description": "Placeholder: makes the change described by the task spec.",
      "fsm": {
        "id": "b2f6ce492d5e47ce9fe3b8dc50ed6b25",
        "name": "implementer_fsm",
        "states": [
          {
