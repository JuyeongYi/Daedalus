      },
      "config": {
        "kind": "agent",
        "model": "inherit",
        "effort": null,
        "hooks": null,
        "tools": null,
        "disallowed_tools": null,
        "permission_mode": "default",
        "max_turns": null,
        "skills": [],
        "mcp_servers": null,
        "memory": null,
        "background": false,
        "isolation": "none",
        "color": null
      },
      "execution_policy": {
        "mode": "fixed",
        "count": 1,
        "join": "all",
        "join_count": null
      },
      "body": "You implement exactly what `TaskSpec` describes — no more.\n\n1. Read `TaskSpec`. If `ReviewFindings` exists, read it too and treat its\n   blocking items as part of the spec.\n2. Make the change. Keep it as small as the acceptance criteria allow.\n3. Run whatever check the acceptance criteria name. If there is none you can run,\n   say so plainly rather than claiming success.\n4. Report what you changed, file by file, and which criteria you verified.\n\nIf the spec cannot be satisfied as written — it contradicts the codebase, or a\nprerequisite is missing — stop and exit through `blocked` with the reason. A\nhalf-finished change reported as done is worse than an honest block.",
      "reference_placements": [],
      "graph_layout": {},
      "edge_layout": {},
      "transfer_on": [
        {
          "name": "implemented",
          "color": "#4488ff",
          "description": "The change is in place and the checks were run."
        },
        {
          "name": "blocked",
          "color": "#dd7744",
          "description": "The spec cannot be satisfied as written."
        }
      ]
    },
    {
      "kind": "agent",
      "id": "abf0cfd9d4794b788d35c373652bfd02",
      "name": "reviewer",
      "description": "Placeholder: judges the change against the acceptance criteria.",
      "fsm": {
        "id": "a53fc58bde4b4527ad81e5a59fdffa08",
        "name": "reviewer_fsm",
        "states": [
          {
            "kind": "entry_point",
